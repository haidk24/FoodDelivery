<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Màu nền bên trong thẻ (Trắng) -->
    <solid android:color="#FFFFFF" />

    <!-- Viền màu vàng hổ phách (Amber) -->
    <!-- width: độ dày của viền -->
    <stroke
        android:width="1.5dp"
        android:color="#FFC107" />

    <!-- Độ bo góc của thẻ -->
    <corners android:radius="12dp" />

    <!-- Khoảng cách giữa nội dung và viền -->
    <padding
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp" />
</shape>