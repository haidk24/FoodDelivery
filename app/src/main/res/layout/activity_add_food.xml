<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FF"
    android:orientation="vertical">

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- 1. Top Bar: Back, Title, Profile Avatar                      -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/white">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="#1E293B" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Thêm món"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111C2D" />

        <FrameLayout
            android:id="@+id/btnProfile"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_avatar_orange"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9" />

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- 2. Main Scrollable Form Content                              -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Banner: Hồ sơ món ăn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner_add_food_info"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_restaurant"
                        app:tint="#AC2D00" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="HỒ SƠ MÓN ĂN"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#AC2D00" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Điền các thông tin hương vị, hình ảnh chuẩn nét và giá cả để hiển thị ngay trên thực đơn của quán."
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- 3. Image Picker Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hình ảnh món ăn"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khuyên dùng tỷ lệ 16:9"
                    android:textSize="12sp"
                    android:textColor="#64748B" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardImagePick"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#E0E7FF"
                app:cardBackgroundColor="#F3F6FD">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Image Preview -->
                    <ImageView
                        android:id="@+id/imgFoodPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <!-- Placeholder Container -->
                    <LinearLayout
                        android:id="@+id/layoutPlaceholderImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_white_rounded_icon_box"
                            android:elevation="2dp">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_add_a_photo"
                                app:tint="#AC2D00" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Chạm để chọn ảnh món"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1E293B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tự động tối ưu hóa và nén chuẩn JPEG sắc nét, tối đa 5MB"
                            android:textSize="12sp"
                            android:textColor="#64748B"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Change Image Floating Pill Badge (Visible when preview is active) -->
                    <LinearLayout
                        android:id="@+id/badgeChangeImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_pill_white"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:elevation="4dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_photo_camera"
                            app:tint="#AC2D00" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Đổi ảnh"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#AC2D00" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. Tên món ăn -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên món ăn *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field_box"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_ramen_dining"
                    app:tint="#8E7461" />

                <EditText
                    android:id="@+id/edtFoodName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Ví dụ: Cơm tấm sườn bì chả đặc biệt"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:singleLine="true"
                    android:imeOptions="actionNext" />
            </LinearLayout>

            <!-- 5. Giá bán & Giá gốc (2 Columns) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Left Column: Giá bán * -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giá bán *"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_field_box"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp">

                        <EditText
                            android:id="@+id/edtFoodNewPrice"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="55.000"
                            android:textColorHint="#94A3B8"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#AC2D00"
                            android:inputType="numberDecimal"
                            android:singleLine="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="đ"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#64748B" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Giá thanh toán của khách"
                        android:textSize="11sp"
                        android:textColor="#64748B" />
                </LinearLayout>

                <!-- Right Column: Giá gốc (Tùy chọn) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Giá gốc"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1E293B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tùy chọn"
                            android:textSize="11sp"
                            android:textColor="#94A3B8" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_field_box"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp">

                        <EditText
                            android:id="@+id/edtFoodOldPrice"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="65.000"
                            android:textColorHint="#94A3B8"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:inputType="numberDecimal"
                            android:singleLine="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="đ"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#64748B" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Để trống nếu không giảm"
                        android:textSize="11sp"
                        android:textColor="#64748B" />
                </LinearLayout>
            </LinearLayout>

            <!-- 6. Khuyến mãi / Giảm giá (%) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khuyến mãi / Giảm giá (%)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_disabled_lavender"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_percent"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvCalculatedDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Tự động tính theo Giá gốc &amp; Giá bán"
                    android:textSize="13sp"
                    android:textColor="#64748B" />
            </LinearLayout>

            <!-- 7. Danh mục phân loại -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh mục phân loại"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/btnSelectCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field_box"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_category"
                    app:tint="#8E7461" />

                <TextView
                    android:id="@+id/tvSelectedCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Món chính"
                    android:textSize="14sp"
                    android:textColor="#0F172A" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="#64748B" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_info"
                    app:tint="#D97706" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Món sẽ hiển thị ở đầu danh sách thực đơn nếu chưa chọn danh mục."
                    android:textSize="11sp"
                    android:textColor="#64748B" />
            </LinearLayout>

            <!-- 8. Mô tả món ăn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mô tả món ăn"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tùy chọn"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field_box"
                android:orientation="vertical"
                android:padding="12dp">

                <EditText
                    android:id="@+id/edtFoodDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:maxLines="6"
                    android:gravity="top|start"
                    android:background="@null"
                    android:hint="Mô tả hương vị đậm đà, thành phần nguyên liệu sạch chuẩn tươi ngon, định lượng suất ăn..."
                    android:textColorHint="#94A3B8"
                    android:textSize="13sp"
                    android:textColor="#0F172A" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="0/200"
                android:textSize="11sp"
                android:textColor="#94A3B8" />

            <!-- 9. Mở bán ngay lập tức Switch Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_availability"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_store_mint">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_store"
                        app:tint="#059669" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mở bán ngay lập tức"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Khách hàng có thể đặt ngay khi lưu"
                        android:textSize="12sp"
                        android:textColor="#64748B" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchIsAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/switch_thumb_selector"
                    app:trackTint="@color/switch_track_selector" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- 10. Bottom Action Bar: Hủy bỏ & LƯU MÓN ĂN                   -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/white">

        <!-- Hủy bỏ Button -->
        <FrameLayout
            android:id="@+id/btnCancel"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_btn_cancel_soft"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Hủy bỏ"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#334155" />
        </FrameLayout>

        <!-- LƯU MÓN ĂN Button -->
        <LinearLayout
            android:id="@+id/btnSaveFood"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_save_dish"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgSaveIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_save"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvSaveButtonText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="LƯU MÓN ĂN"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <ProgressBar
                android:id="@+id/progressBarSave"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
