<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/bg_dialog_rounded">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chỉnh sửa thông tin nhận hàng"
        android:textColor="@color/colorTextPrimary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Vui lòng cung cấp chính xác địa chỉ và số điện thoại nhận món."
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp" />

    <!-- Name Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Họ tên người nhận *"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/dialog_et_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field_box_cart"
        android:paddingHorizontal="12dp"
        android:hint="Họ và tên"
        android:textColor="@color/colorTextPrimary"
        android:textSize="14sp"
        android:singleLine="true" />

    <!-- Phone Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Số điện thoại *"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/dialog_et_phone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field_box_cart"
        android:paddingHorizontal="12dp"
        android:hint="Số điện thoại"
        android:inputType="phone"
        android:textColor="@color/colorTextPrimary"
        android:textSize="14sp"
        android:singleLine="true" />

    <!-- Address Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Địa chỉ giao hàng *"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/dialog_et_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field_box_cart"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:hint="Số nhà, tên đường, phường/xã, quận/huyện..."
        android:textColor="@color/colorTextPrimary"
        android:textSize="14sp"
        android:maxLines="3" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_btn_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Hủy"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_btn_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="Lưu thông tin"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
