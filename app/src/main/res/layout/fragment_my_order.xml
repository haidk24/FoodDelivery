<?xml version="1.0" encoding="utf-8"?>
<!-- Stitch Orders Screen — Warm Culinary Modern (Đơn hàng của tôi) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- ===== FIXED APPBAR: Brand Header + Screen Title + Filter Tabs ===== -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_orders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBackground"
        app:elevation="0dp">

        <!-- Top Brand Header: Logo + Delivery Location + Bell + Avatar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical">

            <!-- App Logo Icon (40x40dp, 12dp radius, #AC2D00) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/colorPrimary"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_restaurant"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Title & Delivery Address -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Food Order Pro"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="1dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:id="@+id/tv_header_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giao tới: Cầu Giấy, Hà Nội"
                        android:textSize="11sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginStart="2dp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/colorTextSecondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notification Bell -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">
                <ImageButton
                    android:id="@+id/btn_notification"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/colorTextPrimary"
                    android:contentDescription="Thông báo" />
                <View
                    android:id="@+id/badge_notification"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_badge_dot"
                    android:visibility="visible" />
            </FrameLayout>

            <!-- User Avatar (38x38dp circular) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_user_avatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="19dp"
                app:cardBackgroundColor="@color/colorPrimary"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <ImageView
                    android:id="@+id/img_user_avatar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Screen Title & Search Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đơn hàng của tôi"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lịch sử và tiến trình đơn giao thời gian thực"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Quick Search Button (40x40dp rounded circle) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_search_order"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/colorSurfaceContainer"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search"
                    app:tint="@color/colorTextSecondary" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Search Input Box (Toggleable) -->
        <LinearLayout
            android:id="@+id/layout_search_box"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_field_box_cart"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/colorTextSecondary" />

            <EditText
                android:id="@+id/et_search_order"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Tìm theo mã đơn hoặc tên món..."
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextMuted"
                android:textSize="13sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Horizontal Filter Chips / Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingVertical="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/layout_filter_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Tab: Tất cả -->
                <LinearLayout
                    android:id="@+id/tab_all"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_filter_chip_active"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_tab_all_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tất cả"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_badge_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_filter_active"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tab: Đang giao -->
                <LinearLayout
                    android:id="@+id/tab_shipping"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/dot_shipping_pulse"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_badge_dot" />

                    <TextView
                        android:id="@+id/tv_tab_shipping_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang giao"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_badge_shipping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_filter_inactive"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tab: Chờ xác nhận -->
                <LinearLayout
                    android:id="@+id/tab_pending"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_tab_pending_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chờ xác nhận"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_badge_pending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_filter_inactive"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tab: Đã xác nhận -->
                <LinearLayout
                    android:id="@+id/tab_confirmed"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tv_tab_confirmed_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã xác nhận"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_badge_confirmed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_filter_inactive"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tab: Đã giao -->
                <LinearLayout
                    android:id="@+id/tab_delivered"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_tab_delivered_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã giao"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_badge_delivered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_filter_inactive"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tab: Đã hủy -->
                <LinearLayout
                    android:id="@+id/tab_cancelled"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_tab_cancelled_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã hủy"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_badge_cancelled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_filter_inactive"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ===== BODY CONTENT: SCROLLABLE ORDERS FEED ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_orders_feed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- RecyclerView for Orders -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <!-- Empty State Container -->
            <LinearLayout
                android:id="@+id/layout_empty_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="32dp"
                    app:cardBackgroundColor="@color/colorPrimaryFixed"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_restaurant"
                        app:tint="@color/colorPrimary" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_empty_orders_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Chưa có đơn hàng nào"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Hương vị thơm ngon đang chờ bạn khám phá. Hãy thử ngay một món mới!"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_explore_dishes"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="16dp"
                    android:text="Khám phá món ngon"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="21dp" />
            </LinearLayout>

            <!-- 24/7 Food Care Customer Support Helper Card -->
            <LinearLayout
                android:id="@+id/card_customer_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_support_bottom_card"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="@color/colorSurfaceContainerHighest"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_support_agent"
                        app:tint="@color/colorPrimary" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cần hỗ trợ về đơn hàng?"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Đội ngũ Chăm sóc khách hàng luôn sẵn sàng 24/7"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_contact_support"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Liên hệ"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
