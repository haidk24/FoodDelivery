<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FF">

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Main Content Container                                       -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ──────────────────────────────────────────────────────────── -->
        <!-- 1. Top Bar: Restaurant Name, Open Status Pill, Bell, Avatar -->
        <!-- ──────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_restaurant_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#111C2D" />

                    <!-- Status Pill: Mở cửa -->
                    <LinearLayout
                        android:id="@+id/layout_status_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_restaurant_open"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_badge_dot"
                            android:backgroundTint="#15803D"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tv_restaurant_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#15803D" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_restaurant_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Quản lý thực đơn"
                    android:textSize="12sp"
                    android:textColor="#64748B" />
            </LinearLayout>

            <!-- Notification Bell with Red Dot -->
            <FrameLayout
                android:id="@+id/btn_notifications"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notifications"
                    app:tint="#111C2D" />

                <View
                    android:id="@+id/view_notification_dot"
                    android:visibility="gone"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_dot" />
            </FrameLayout>

            <!-- Profile Avatar Button -->
            <FrameLayout
                android:id="@+id/btn_profile"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_avatar_orange"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EAEFF5" />

        <!-- ──────────────────────────────────────────────────────────── -->
        <!-- 2. Header: Title, Counter & Filter Button                     -->
        <!-- ──────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thực đơn của quán"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111C2D" />

                <!-- Counters: 24 món đang bán • 2 món tạm ẩn -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_badge_dot"
                        android:backgroundTint="#15803D"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tv_count_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 món đang bán"
                        android:textSize="12sp"
                        android:textColor="#475569" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textSize="12sp"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tv_count_hidden"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 món tạm ẩn"
                        android:textSize="12sp"
                        android:textColor="#94A3B8" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tune / Filter Button -->
            <FrameLayout
                android:id="@+id/btn_filter_tune"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_square_icon_tune"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tune"
                    app:tint="#475569" />
            </FrameLayout>
        </LinearLayout>

        <!-- ──────────────────────────────────────────────────────────── -->
        <!-- 3. Search Bar                                                -->
        <!-- ──────────────────────────────────────────────────────────── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search_input_gray"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    android:layout_marginEnd="10dp"
                    app:tint="#94A3B8" />

                <EditText
                    android:id="@+id/et_search_food"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Tìm món trong thực đơn..."
                    android:textColor="#111C2D"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />

                <ImageView
                    android:id="@+id/btn_clear_search"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#94A3B8" />
            </LinearLayout>
        </FrameLayout>

        <!-- ──────────────────────────────────────────────────────────── -->
        <!-- 4. Category Filter Chips (Horizontal Scroll)                 -->
        <!-- ──────────────────────────────────────────────────────────── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Chip Tất cả -->
                <TextView
                    android:id="@+id/chip_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_category_selected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Tất cả (0)"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Chip Món chính -->
                <TextView
                    android:id="@+id/chip_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_category_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Món chính (0)"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Chip Khai vị -->
                <TextView
                    android:id="@+id/chip_appetizer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_category_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Khai vị (0)"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Chip Đồ uống -->
                <TextView
                    android:id="@+id/chip_drink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_category_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Đồ uống (0)"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Chip Tráng miệng -->
                <TextView
                    android:id="@+id/chip_dessert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_category_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Tráng miệng (0)"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ──────────────────────────────────────────────────────────── -->
        <!-- 5. Food List (RecyclerView) & Empty State                    -->
        <!-- ──────────────────────────────────────────────────────────── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Loading Spinner -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_restaurant"
                    app:tint="#CBD5E1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Không tìm thấy món ăn nào"
                    android:textColor="#111C2D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Vui lòng thử từ khóa tìm kiếm hoặc danh mục khác"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- RecyclerView for Food Items -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMenu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="120dp"
                android:overScrollMode="never" />

        </FrameLayout>
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- 6. Floating Action Button: + Thêm món mới                    -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/fabAddFood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="76dp"
        android:background="@drawable/bg_fab_add_food"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_add"
            android:layout_marginEnd="6dp"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thêm món mới"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- 7. Bottom Navigation Bar for Restaurant Role                 -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemRippleColor="@android:color/transparent"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
