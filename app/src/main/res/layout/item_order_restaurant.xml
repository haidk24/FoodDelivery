<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Accent Border Strip -->
        <View
            android:id="@+id/view_status_accent_line"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#F59E0B" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Header Row: Order ID + Copy Icon + Status Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_order_id"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#SAYMDfDKIZrz6..."
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <ImageView
                            android:id="@+id/btn_copy_order_id"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_content_copy"
                            app:tint="#64748B"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_schedule"
                            app:tint="#64748B"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tv_order_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15:49 - Hôm nay"
                            android:textSize="11sp"
                            android:textColor="#64748B" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Status Badge Pill -->
                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_pending"
                    android:text="● CHỜ XÁC NHẬN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#D97706" />

            </LinearLayout>

            <!-- 2. Customer Info Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_order_customer_box"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_restaurant"
                    app:tint="#C2410C"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_customer_name_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thái Võ • 0966464945"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/tv_customer_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Số 12 Cầu Giấy, Hà Nội"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Phone Call Button -->
                <FrameLayout
                    android:id="@+id/btn_call_customer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_white_circle_shadow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_phone"
                        app:tint="#C2410C" />
                </FrameLayout>
            </LinearLayout>

            <!-- 3. Food Items Container -->
            <LinearLayout
                android:id="@+id/layout_order_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <!-- Dynamic Item rows inflated programmatically or populated here -->
            </LinearLayout>

            <!-- 4. Payment & Sub-status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_payment_method_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_search_input_gray"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Tiền mặt COD"
                    android:textSize="10sp"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/tv_cooking_shipper_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="🌿 Đang nấu"
                    android:textSize="11sp"
                    android:textColor="#0D9488"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_total_price_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng thu: "
                    android:textSize="12sp"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/tv_total_price_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="115.000 đ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#AC2D00" />
            </LinearLayout>

            <!-- 5. Big Action Button -->
            <Button
                android:id="@+id/btn_action_primary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_confirm_order"
                android:text="✓ XÁC NHẬN ĐƠN"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                app:backgroundTint="@null" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
