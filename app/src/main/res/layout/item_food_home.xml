<?xml version="1.0" encoding="utf-8"?>
<!-- item_food_home.xml — Food row card matching Stitch design -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="@color/white"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Left: Text content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="10dp">

            <!-- Badge + Food Name row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Discount Badge (visible when discount > 0) -->
                <TextView
                    android:id="@+id/tv_discount_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_badge_error"
                    android:text="-25%"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/badge_red_text"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="-25%" />

                <!-- Best Seller Badge (alternative) -->
                <TextView
                    android:id="@+id/tv_bestseller_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_badge_amber"
                    android:text="Bán chạy"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/badge_amber_text"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_food_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Gỏi cuốn tôm thịt" />
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/tv_food_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Tôm tươi mọng nước, thịt ba chỉ luộc mềm cuốn bánh tráng rau sống chấm tương bơ lạc thơm nồng." />

            <!-- Price row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_new_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    tools:text="75.000 đ" />

                <TextView
                    android:id="@+id/tv_old_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextMuted"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="100.000 đ" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right: Food Image + Add Button -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/img_food"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banh" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Add to Cart circular button (bottom-right of image) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_add_to_cart"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-4dp"
                android:layout_marginBottom="-4dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/colorPrimary"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white"
                    android:contentDescription="Thêm vào giỏ" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
