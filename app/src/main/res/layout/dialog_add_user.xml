<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Họ và tên"
        android:textSize="12sp"
        android:textColor="#64748B" />

    <EditText
        android:id="@+id/edt_new_user_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_active_pill"
        android:backgroundTint="#F1F5F9"
        android:paddingHorizontal="12dp"
        android:hint="Nguyễn Văn A"
        android:textSize="14sp"
        android:inputType="textPersonName" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Email đăng ký"
        android:textSize="12sp"
        android:textColor="#64748B" />

    <EditText
        android:id="@+id/edt_new_user_email"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_active_pill"
        android:backgroundTint="#F1F5F9"
        android:paddingHorizontal="12dp"
        android:hint="nguyenvana@gmail.com"
        android:textSize="14sp"
        android:inputType="textEmailAddress" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Số điện thoại"
        android:textSize="12sp"
        android:textColor="#64748B" />

    <EditText
        android:id="@+id/edt_new_user_phone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_active_pill"
        android:backgroundTint="#F1F5F9"
        android:paddingHorizontal="12dp"
        android:hint="0912345678"
        android:textSize="14sp"
        android:inputType="phone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Mật khẩu tạm thời (ít nhất 6 ký tự)"
        android:textSize="12sp"
        android:textColor="#64748B" />

    <EditText
        android:id="@+id/edt_new_user_password"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_active_pill"
        android:backgroundTint="#F1F5F9"
        android:paddingHorizontal="12dp"
        android:hint="••••••••"
        android:textSize="14sp"
        android:inputType="textPassword" />
</LinearLayout>
