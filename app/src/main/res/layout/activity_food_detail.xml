<?xml version="1.0" encoding="utf-8"?>
<!-- activity_food_detail.xml — Refactored to match Stitch Warm Culinary Modern -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- ===== FIXED TOP BAR ===== -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBackground"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical">

            <!-- Back button -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/colorTextPrimary"
                android:contentDescription="Quay lại" />

            <!-- Title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Chi Tiết Món Ăn"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <!-- User Avatar (32x32dp circular #AC2D00) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_user_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/colorPrimary"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <ImageView
                    android:id="@+id/img_user_avatar"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ===== MAIN SCROLLABLE CONTENT ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== HERO FOOD IMAGE CONTAINER ===== -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="280dp">

                <ImageView
                    android:id="@+id/img_food"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banh" />

                <!-- Gradient overlay at bottom of image for smooth transition -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/bg_banner_circle"
                    android:visibility="gone" />

                <!-- Top-Right Action Buttons (Favorite + Share) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="16dp"
                    android:orientation="horizontal">

                    <!-- Favorite Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_favorite"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#E6FFFFFF"
                        app:cardElevation="4dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/img_favorite_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_favorite_border"
                            app:tint="@color/colorTextPrimary" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Share Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_share"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#E6FFFFFF"
                        app:cardElevation="4dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_share"
                            app:tint="@color/colorTextPrimary" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Floating Pill Badge at bottom-left: "Món bán chạy nhất" -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_bestseller_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="#F2FFFFFF"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_fire"
                            app:tint="@color/colorSecondaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Món bán chạy nhất"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </RelativeLayout>

            <!-- ===== BODY SPECIFICATION CARDS ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="-8dp">

                <!-- MAIN CARD BODY -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Meta Row: Discount Badge & Prep Time -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Discount Tag Badge -->
                            <LinearLayout
                                android:id="@+id/layout_discount_tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_badge_error"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_sell"
                                    app:tint="@color/badge_red_text" />

                                <TextView
                                    android:id="@+id/tv_discount_tag"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="-25% ƯU ĐÃI HÔM NAY"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/badge_red_text" />
                            </LinearLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <!-- Delivery / Prep Time -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_schedule"
                                    app:tint="@color/colorTertiary" />

                                <TextView
                                    android:id="@+id/tv_prep_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="15–20 phút"
                                    android:textSize="12sp"
                                    android:textColor="@color/colorTextSecondary" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Food Name -->
                        <TextView
                            android:id="@+id/tv_food_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Gỏi cuốn tôm thịt"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <!-- Price Row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="6dp">

                            <TextView
                                android:id="@+id/tv_new_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="75.000 đ"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimary" />

                            <TextView
                                android:id="@+id/tv_old_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="100.000 đ"
                                android:textSize="14sp"
                                android:textColor="@color/colorTextMuted" />
                        </LinearLayout>

                        <!-- Restaurant Tile -->
                        <LinearLayout
                            android:id="@+id/card_restaurant_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_chip_option_inactive"
                            android:padding="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Storefront icon circular squircle -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardCornerRadius="20dp"
                                app:cardBackgroundColor="#FFDBD1"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:id="@+id/img_restaurant_logo"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_storefront"
                                    app:tint="@color/colorPrimary" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Restaurant Name & Rating -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="10dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:id="@+id/tv_restaurant_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Đang tải thông tin quán"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/colorTextPrimary"
                                        android:maxLines="1"
                                        android:ellipsize="end" />

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginStart="4dp"
                                        android:src="@drawable/ic_verified"
                                        app:tint="@color/colorTertiary" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="2dp">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:src="@drawable/ic_star"
                                        app:tint="@color/colorSecondaryContainer" />

                                    <TextView
                                        android:id="@+id/tv_restaurant_rating"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="2dp"
                                        android:text="4.8"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/colorTextPrimary" />

                                    <TextView
                                        android:id="@+id/tv_restaurant_reviews"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="(128 đánh giá)"
                                        android:textSize="11sp"
                                        android:textColor="@color/colorTextSecondary" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Status Badge -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                app:cardCornerRadius="12dp"
                                app:cardBackgroundColor="@color/badge_green_bg"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:paddingHorizontal="10dp"
                                    android:text="Đang mở cửa"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/badge_green_text" />
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- Mô tả món ăn -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Mô tả món ăn"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <TextView
                            android:id="@+id/tv_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Tôm sú tươi ngon hấp chín tới, thịt ba chỉ luộc thái mỏng, cuộn cùng bún tươi và các loại rau thơm chuẩn vị Hà Nội. Chấm cùng sốt tương đậu phộng béo bùi đậm đà."
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/colorTextSecondary" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- FLAVOR OPTIONS CARD ("Tùy chọn khẩu vị") -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tùy chọn khẩu vị"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                app:cardCornerRadius="11dp"
                                app:cardBackgroundColor="@color/colorSurfaceContainer"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:paddingHorizontal="8dp"
                                    android:text="Không bắt buộc"
                                    android:textSize="10sp"
                                    android:textColor="@color/colorTextSecondary" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Chọn ghi chú chuẩn bị cho đầu bếp quán"
                            android:textSize="12sp"
                            android:textColor="@color/colorTextSecondary" />

                        <!-- Options Chips: Row 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                            <!-- Option 1: Ít cay -->
                            <LinearLayout
                                android:id="@+id/chip_opt_mild_spicy"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_chip_option_inactive"
                                android:paddingHorizontal="14dp"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:id="@+id/icon_opt_mild_spicy"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_tune"
                                    app:tint="@color/colorTextSecondary" />

                                <TextView
                                    android:id="@+id/text_opt_mild_spicy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="Ít cay"
                                    android:textSize="12sp"
                                    android:textColor="@color/colorTextPrimary" />
                            </LinearLayout>

                            <!-- Option 2: Không rau thơm -->
                            <LinearLayout
                                android:id="@+id/chip_opt_no_herbs"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginStart="8dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_chip_option_inactive"
                                android:paddingHorizontal="14dp"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:id="@+id/icon_opt_no_herbs"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_eco"
                                    app:tint="@color/colorTextSecondary" />

                                <TextView
                                    android:id="@+id/text_opt_no_herbs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="Không rau thơm"
                                    android:textSize="12sp"
                                    android:textColor="@color/colorTextPrimary" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Options Chips: Row 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <!-- Option 3: Thêm nước chấm -->
                            <LinearLayout
                                android:id="@+id/chip_opt_extra_sauce"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_chip_option_inactive"
                                android:paddingHorizontal="14dp"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:id="@+id/icon_opt_extra_sauce"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_soup"
                                    app:tint="@color/colorTextSecondary" />

                                <TextView
                                    android:id="@+id/text_opt_extra_sauce"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="Thêm nước chấm"
                                    android:textSize="12sp"
                                    android:textColor="@color/colorTextPrimary" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KITCHEN CARE NOTICE CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/colorSurfaceLow"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="top">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="1dp"
                            android:src="@drawable/ic_verified_user"
                            app:tint="@color/colorSecondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cam kết nguyên liệu tươi sạch"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Món ăn được cuộn tươi tại chỗ ngay sau khi nhận đơn, bảo đảm hương vị giòn ngọt thanh mát."
                                android:textSize="11sp"
                                android:textColor="@color/colorTextSecondary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== PERSISTENT FLOATING BOTTOM ACTION DOCK ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_bottom_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="12dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical">

            <!-- Stepper Widget -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_stepper_pill"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="2dp">

                <!-- Decrement button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_decrement"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_remove"
                        app:tint="@color/colorTextPrimary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Quantity indicator -->
                <TextView
                    android:id="@+id/tv_quantity"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />

                <!-- Increment button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_increment"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="@color/colorPrimary"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Add to Cart Primary Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_to_cart"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/colorPrimary"
                app:icon="@drawable/ic_shopping_bag"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:iconSize="18dp"
                app:iconPadding="4dp"
                android:paddingHorizontal="6dp"
                android:text="Thêm vào giỏ hàng - 75.000 đ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:singleLine="true"
                app:elevation="3dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
