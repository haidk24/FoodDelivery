<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Screen Header: Title + Add Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <!-- Icon Circle -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_avatar_pink">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_people"
                    app:tint="#962808" />
            </FrameLayout>

            <!-- Title & Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tài khoản &amp; Phân quyền"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:textColor="@color/colorTextPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tổng quan danh sách người dùng hệ thống"
                    android:textSize="11.5sp"
                    android:textColor="@color/colorTextSecondary"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- + Thêm Button -->
            <LinearLayout
                android:id="@+id/btn_add_user"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_btn_add_user"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Thêm"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3 Metric Cards Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <!-- Card 1: Tổng cộng -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TỔNG CỘNG"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:textColor="#64748B" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_total_users"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="2dp"
                            android:text="tk"
                            android:textSize="11sp"
                            android:textColor="#64748B" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Hoạt động -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOẠT ĐỘNG"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:textColor="#0D9488" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_active_users"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_dot_green" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Bị khóa -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BỊ KHÓA"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:textColor="#DC2626" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_banned_users"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:textColor="#DC2626" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="2dp"
                            android:text="vi phạm"
                            android:textSize="10.5sp"
                            android:textColor="#DC2626" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Search & Filter Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_tab_active_pill"
                android:backgroundTint="#F1F5F9"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    app:tint="#64748B" />

                <EditText
                    android:id="@+id/edt_search_user"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="Tìm theo họ tên, email, sđt..."
                    android:textColorHint="#94A3B8"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="13sp"
                    android:inputType="text"
                    android:imeOptions="actionSearch" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btn_filter_dialog"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tab_active_pill"
                android:backgroundTint="#F1F5F9"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tune"
                    app:tint="#334155" />
            </FrameLayout>
        </LinearLayout>

        <!-- Filter Chips Row (Tất cả | Khách hàng | Nhà hàng | Bị khóa) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp">

            <LinearLayout
                android:id="@+id/layout_filter_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Chip 1: Tất cả -->
                <LinearLayout
                    android:id="@+id/chip_filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_btn_filter_user_inactive"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_filter_all_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tất cả"
                        android:textSize="12.5sp"
                        android:textColor="#475569" />

                    <TextView
                        android:id="@+id/tv_badge_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_pill_gray"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textSize="10.5sp"
                        android:textColor="#475569" />
                </LinearLayout>

                <!-- Chip 2: Khách hàng -->
                <LinearLayout
                    android:id="@+id/chip_filter_customer"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_btn_filter_user_active"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/img_check_customer"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tv_filter_customer_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khách hàng"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tv_badge_customer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_pill_gray"
                        android:backgroundTint="#7F1D1D"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textSize="10.5sp"
                        android:textColor="@color/white" />
                </LinearLayout>

                <!-- Chip 3: Nhà hàng -->
                <LinearLayout
                    android:id="@+id/chip_filter_restaurant"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_btn_filter_user_inactive"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_restaurant"
                        app:tint="#64748B" />

                    <TextView
                        android:id="@+id/tv_filter_restaurant_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nhà hàng"
                        android:textSize="12.5sp"
                        android:textColor="#475569" />

                    <TextView
                        android:id="@+id/tv_badge_restaurant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_pill_gray"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textSize="10.5sp"
                        android:textColor="#475569" />
                </LinearLayout>

                <!-- Chip 4: Bị khóa -->
                <LinearLayout
                    android:id="@+id/chip_filter_banned"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_btn_filter_user_inactive"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_filter_banned_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bị khóa"
                        android:textSize="12.5sp"
                        android:textColor="#475569" />

                    <TextView
                        android:id="@+id/tv_badge_banned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_pill_gray"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textSize="10.5sp"
                        android:textColor="#475569" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- User List Content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layout_empty_users"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_people"
                    app:tint="#94A3B8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Không tìm thấy người dùng phù hợp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hãy thử tìm kiếm với tên hoặc email khác"
                    android:textSize="12.5sp"
                    android:textColor="#64748B" />
            </LinearLayout>

            <!-- Loading spinner -->
            <ProgressBar
                android:id="@+id/progress_user_list"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom Footer: Xem thêm người dùng -->
        <LinearLayout
            android:id="@+id/layout_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/btn_load_more_users"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_btn_load_more"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="#1E40AF" />

                <TextView
                    android:id="@+id/tv_load_more_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Xem thêm"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1E40AF" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_records_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Hiển thị 0 bản ghi"
                android:textSize="11sp"
                android:textColor="#94A3B8" />

            <ProgressBar
                android:id="@+id/progress_load_more"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="4dp"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
