<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Back & Edit -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:scaleType="centerInside"
                android:layout_alignParentStart="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi tiết người dùng"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_centerInParent="true"
                android:textColor="#1C1C1E"/>

            <ImageButton
                android:id="@+id/btn_edit_user"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Chỉnh sửa"
                android:scaleType="centerInside"
                android:layout_alignParentEnd="true"
                app:tint="#007AFF"/>
        </RelativeLayout>

        <!-- Avatar + tên + email -->
        <LinearLayout
            android:id="@+id/card_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_initials"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#0C447C"
                android:layout_marginEnd="14dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1C1C1E"/>

                <TextView
                    android:id="@+id/tv_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#8A8A8E"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Thông tin chi tiết -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp">

            <TextView
                android:text="Thông tin tài khoản"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:paddingBottom="8dp"/>

            <View android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#E0E0E0"/>

            <!-- Row: SĐT -->
            <LinearLayout 
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">
                <TextView android:text="Số điện thoại"
                    android:textSize="13sp" android:textColor="#636366"
                    android:layout_width="120dp" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tv_phone"
                    android:textSize="13sp" android:textColor="#1C1C1E"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Row: Vai trò -->
            <LinearLayout 
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">
                <TextView android:text="Vai trò"
                    android:textSize="13sp" android:textColor="#636366"
                    android:layout_width="120dp" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tv_role"
                    android:textSize="13sp" android:textColor="#1C1C1E"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Row: Ngày đăng ký -->
            <LinearLayout 
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">
                <TextView android:text="Ngày đăng ký"
                    android:textSize="13sp" android:textColor="#636366"
                    android:layout_width="120dp" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tv_created_at"
                    android:textSize="13sp" android:textColor="#1C1C1E"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Row: Tổng đơn -->
            <LinearLayout 
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">
                <TextView android:text="Tổng đơn hàng"
                    android:textSize="13sp" android:textColor="#636366"
                    android:layout_width="120dp" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tv_order_count"
                    android:textSize="13sp" android:textStyle="bold"
                    android:textColor="#007AFF"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Nút hành động -->
        <Button
            android:id="@+id/btn_ban_unban"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Khóa tài khoản"
            android:textSize="14sp"
            android:backgroundTint="#FDECEA"
            android:textColor="#8B1A1A"
            android:layout_marginBottom="8dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

    </LinearLayout>
</ScrollView>
