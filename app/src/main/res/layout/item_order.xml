<?xml version="1.0" encoding="utf-8"?>
<!-- Stitch Order Card Item — Warm Culinary Modern -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Live Ambient Active Indicator on Left Edge (for shipping orders) -->
        <View
            android:id="@+id/indicator_active_shipping"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignTop="@+id/layout_order_content"
            android:layout_alignBottom="@+id/layout_order_content"
            android:background="@color/colorTertiary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_order_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header Row: Order ID, Time & Status Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvOrderId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#ORDER123"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOrderTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="22:53 • 12/04"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Restaurant Name -->
                    <TextView
                        android:id="@+id/tvRestaurantName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Mạnh Tiến Quán"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- Restaurant Address -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="1dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_storefront"
                            app:tint="@color/colorTextMuted" />

                        <TextView
                            android:id="@+id/tvRestaurantAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:text="Hoàn Kiếm, Hà Nội"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Status Badge Column -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <!-- Status Pill -->
                    <TextView
                        android:id="@+id/tvOrderStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_status_shipping"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="● Đang giao hàng"
                        android:textColor="@color/colorTertiary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Optional Review Rating Badge -->
                    <TextView
                        android:id="@+id/tvOrderRatingBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="★ Đã đánh giá 5.0"
                        android:textColor="@color/colorSecondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dishes Summary Preview Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field_box_cart"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical">

                <!-- Food Thumbnail Image -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgOrderFoodThumbnail"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banh"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

                <!-- Items Text -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOrderDishesSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1x Gỏi cuốn tôm thịt, 1x Bún chả..."
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvOrderDishesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="2 món • Kèm nước mắm ớt"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Amount Column -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/tvPaymentLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thu hộ COD"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="115.000 đ"
                        android:textColor="@color/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Customer Info (for Restaurant View mode) -->
            <TextView
                android:id="@+id/tvCustomerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Khách: Hải VT - 0123456789\nĐịa chỉ: Số 3 Cầu Giấy, Hà Nội" />

            <!-- Live Dispatch Shipper Tracker Box (shown when delivering) -->
            <LinearLayout
                android:id="@+id/layout_shipper_dispatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field_box_cart"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        app:cardCornerRadius="11dp"
                        app:cardBackgroundColor="@color/colorPrimaryFixed"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_moped"
                            app:tint="@color/colorPrimary" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tv_shipper_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Tài xế: Nguyễn Văn An (29B1-884.21)"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_shipper_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="~ 8 phút nữa"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Thin Delivery Progress Bar -->
                <ProgressBar
                    android:id="@+id/progress_delivery"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="75"
                    android:progressTint="@color/colorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tv_delivery_dest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đang tới: Số 3 Cầu Giấy, Hà Nội"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/btn_call_shipper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gọi tài xế"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Review Delight Banner (shown when delivered and not yet reviewed) -->
            <LinearLayout
                android:id="@+id/layout_review_delight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_banner_review_delight"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_sentiment_satisfied"
                    app:tint="@color/colorSecondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Món ăn vừa vị không bạn? Hãy gửi vài lời khen nhé!"
                    android:textColor="@color/colorOnSecondaryFixedVariant"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+20 xu"
                    android:textColor="@color/colorSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Customer Interactive Actions Row -->
            <LinearLayout
                android:id="@+id/layoutCustomerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Action Button 1 (Chi tiết / Xem nhận xét / Đặt lại đơn) -->
                <LinearLayout
                    android:id="@+id/btnSecondaryAction"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_order_action_light"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivSecondaryIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_receipt"
                        app:tint="@color/colorTextPrimary" />

                    <TextView
                        android:id="@+id/tvSecondaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Chi tiết"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Spacer -->
                <View
                    android:id="@+id/spacerActions"
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <!-- Action Button 2 (Theo dõi đơn hàng / Đánh giá ngay / Đặt lại đơn) -->
                <LinearLayout
                    android:id="@+id/btnPrimaryAction"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_order_action_track"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivPrimaryIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_near_me"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvPrimaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Theo dõi đơn hàng"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Restaurant Mode Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateStatus"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="XÁC NHẬN ĐƠN"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>